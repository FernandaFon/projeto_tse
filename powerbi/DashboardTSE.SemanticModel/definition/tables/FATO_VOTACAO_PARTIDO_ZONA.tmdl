table FATO_VOTACAO_PARTIDO_ZONA
	lineageTag: 463879d1-4672-5c94-96db-091ca555ee50

	/// Base 5.
	measure 'Votos nominais do partido (zona)' = SUM(FATO_VOTACAO_PARTIDO_ZONA[qt_votos_nominais])
		formatString: #,0
		lineageTag: 48fe6b00-3a71-5862-a47f-ad1388b0ac74

	measure 'Votos de legenda do partido (zona)' = SUM(FATO_VOTACAO_PARTIDO_ZONA[qt_votos_legenda])
		formatString: #,0
		lineageTag: c43cfa72-0218-522c-b8e1-e7eeac297796

	measure 'Votos válidos do partido (zona)' = [Votos nominais do partido (zona)] + [Votos de legenda do partido (zona)]
		formatString: #,0
		lineageTag: 6a60d9a4-4fcb-5892-9664-9a01a06f0437

	measure 'Índice de legenda (zona) · K5' = DIVIDE([Votos de legenda do partido (zona)], [Votos válidos do partido (zona)])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a904b165-9534-5b99-85f9-4678d1188ba8

	/// Votos válidos do(s) partido(s) selecionado(s) ÷ votos válidos de todos os partidos.
	measure 'Participação do partido nos válidos' = DIVIDE([Votos válidos do partido (zona)], CALCULATE([Votos válidos do partido (zona)], ALL(DIM_AGREMIACAO)))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 86163335-b79e-5874-9e5f-33d62d4d4e2b

