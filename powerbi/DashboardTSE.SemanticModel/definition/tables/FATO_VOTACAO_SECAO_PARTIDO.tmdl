table FATO_VOTACAO_SECAO_PARTIDO
	lineageTag: d900bff8-d70d-5002-9dec-281cb0c6e81b

	/// Bases 1 a 4 e 9.
	measure 'Votos (seção × partido)' = SUM(FATO_VOTACAO_SECAO_PARTIDO[qt_votos])
		formatString: #,0
		lineageTag: f079c9f1-1b1b-5f6f-91d5-bf88a7c72b26

	measure 'Votos de legenda (seção)' = CALCULATE([Votos (seção × partido)], DIM_TIPO_VOTO[Tipo de voto] = "LEGENDA")
		formatString: #,0
		lineageTag: 6734e626-f652-5b64-aa19-d7cd93bb935f

	measure 'Votos válidos (seção)' = CALCULATE([Votos (seção × partido)], DIM_TIPO_VOTO[Voto válido] = TRUE())
		formatString: #,0
		lineageTag: 82ad5190-b945-5f9f-84cd-9e7babc13781

	/// K5 por seção: legenda ÷ (nominais + legenda).
	measure 'Índice de legenda (seção) · K5' = DIVIDE([Votos de legenda (seção)], [Votos válidos (seção)])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: fc9d8f48-bc72-55fd-bf75-438956ca6069

