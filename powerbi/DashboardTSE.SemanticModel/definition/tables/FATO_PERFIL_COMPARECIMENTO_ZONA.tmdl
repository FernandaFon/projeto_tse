	partition FATO_PERFIL_COMPARECIMENTO_ZONA = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(Servidor, Banco),
				    Tabela = Fonte{[Schema="dw", Item="FATO_PERFIL_COMPARECIMENTO_ZONA"]}[Data],
				    Colunas = Table.SelectColumns(Tabela, {"sk_eleicao", "sk_municipio", "sk_zona", "sk_perfil", "qt_aptos", "qt_comparecimento", "qt_abstencao"})
				in
