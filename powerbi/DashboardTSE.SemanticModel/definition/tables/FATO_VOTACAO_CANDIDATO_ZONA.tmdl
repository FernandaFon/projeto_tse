	partition FATO_VOTACAO_CANDIDATO_ZONA = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(Servidor, Banco),
				    Tabela = Fonte{[Schema="dw", Item="FATO_VOTACAO_CANDIDATO_ZONA"]}[Data],
				    Colunas = Table.SelectColumns(Tabela, {"sk_eleicao", "sk_cargo", "sk_municipio", "sk_zona", "sk_candidato", "sk_agremiacao", "qt_votos_nominais", "qt_votos_nominais_validos", "ds_sit_tot_turno"}),
