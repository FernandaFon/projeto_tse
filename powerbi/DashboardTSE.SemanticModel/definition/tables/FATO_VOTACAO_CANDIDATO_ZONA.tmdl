table FATO_VOTACAO_CANDIDATO_ZONA
	lineageTag: beb7659d-ba43-5300-b8d2-c852d48c04db

	/// Base 6.
	measure 'Votos nominais válidos (candidato)' = SUM(FATO_VOTACAO_CANDIDATO_ZONA[qt_votos_nominais_validos])
		formatString: #,0
		lineageTag: 73471c72-4ec9-5f0f-82d8-1ff7882998f6

	measure '% dos válidos (candidato)' = DIVIDE([Votos nominais válidos (candidato)], CALCULATE([Votos nominais válidos (candidato)], ALL(DIM_CANDIDATO)))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 1ff1611f-9541-5dda-991c-173d8cfe4f79

	/// K4: |% 1º colocado − % 2º colocado| sobre os votos válidos.
	measure 'Margem de competitividade (p.p.) · K4' =
			VAR _t = ADDCOLUMNS(SUMMARIZE(FATO_VOTACAO_CANDIDATO_ZONA, DIM_CANDIDATO[sk_candidato]),
			                    "@v", CALCULATE(SUM(FATO_VOTACAO_CANDIDATO_ZONA[qt_votos_nominais_validos])))
			VAR _total = SUMX(_t, [@v])
			VAR _top2 = TOPN(2, _t, [@v], DESC)
			RETURN
			    IF(COUNTROWS(_top2) >= 2, 100 * DIVIDE(MAXX(_top2, [@v]) - MINX(_top2, [@v]), _total))
		formatString: #,0.0" p.p."
		lineageTag: 4940f61a-5a6e-5bfe-be70-d16a24f04dc4

	measure 'Limite de disputa (p.p.)' = SELECTEDVALUE('Limite de disputa'[Limite (p.p.)], 5)
		formatString: 0
		lineageTag: 3cc2c8ed-2a4d-535a-ba18-ad4f6bd94e6b

	/// Só por zona: no total fica vazio.
	measure 'Zona de disputa?' =
			VAR _m = [Margem de competitividade (p.p.) · K4]
			RETURN
			    IF(ISINSCOPE(DIM_ZONA[Zona (capital)]) && NOT ISBLANK(_m),
			       IF(_m < [Limite de disputa (p.p.)], "Sim", "Não"))
		lineageTag: fe063110-ac3d-5510-834a-bcee300b48ad

	measure 'Zonas de disputa' =
			COUNTROWS(
			    FILTER(VALUES(DIM_ZONA[sk_zona]),
			        VAR _m = [Margem de competitividade (p.p.) · K4]
			        RETURN NOT ISBLANK(_m) && _m < [Limite de disputa (p.p.)]))
		formatString: #,0
		lineageTag: 9319c06b-23e3-5576-b598-be3aeef4d9d1

