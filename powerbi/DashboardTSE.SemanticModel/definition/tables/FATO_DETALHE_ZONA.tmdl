table FATO_DETALHE_ZONA
	lineageTag: 1a02499d-2396-55ba-b365-4013b88727d4

	/// Base 7. Eleitores aptos.
	measure 'Aptos (zona)' =
			VAR _cargo = IF(HASONEVALUE(DIM_CARGO[cd_cargo]), VALUES(DIM_CARGO[cd_cargo]), 1)
			VAR _turno = IF(HASONEVALUE(DIM_ELEICAO[nr_turno]), VALUES(DIM_ELEICAO[nr_turno]), 1)
			RETURN
			    CALCULATE(SUM(FATO_DETALHE_ZONA[qt_aptos]), DIM_CARGO[cd_cargo] = _cargo, DIM_ELEICAO[nr_turno] = _turno)
		formatString: #,0
		lineageTag: 396e515a-88c8-545e-b367-2280b89f5f4c

	measure 'Comparecimento (zona)' =
			VAR _cargo = IF(HASONEVALUE(DIM_CARGO[cd_cargo]), VALUES(DIM_CARGO[cd_cargo]), 1)
			VAR _turno = IF(HASONEVALUE(DIM_ELEICAO[nr_turno]), VALUES(DIM_ELEICAO[nr_turno]), 1)
			RETURN
			    CALCULATE(SUM(FATO_DETALHE_ZONA[qt_comparecimento]), DIM_CARGO[cd_cargo] = _cargo, DIM_ELEICAO[nr_turno] = _turno)
		formatString: #,0
		lineageTag: a98115b0-73f7-53f7-98fa-c8c1ed44a239

	/// K6: abstenções em número absoluto.
	measure 'Abstenções (zona) · K6' =
			VAR _cargo = IF(HASONEVALUE(DIM_CARGO[cd_cargo]), VALUES(DIM_CARGO[cd_cargo]), 1)
			VAR _turno = IF(HASONEVALUE(DIM_ELEICAO[nr_turno]), VALUES(DIM_ELEICAO[nr_turno]), 1)
			RETURN
			    CALCULATE(SUM(FATO_DETALHE_ZONA[qt_abstencoes]), DIM_CARGO[cd_cargo] = _cargo, DIM_ELEICAO[nr_turno] = _turno)
		formatString: #,0
		lineageTag: f4f2ed24-f09b-5ad3-9774-c331d135340d

	/// K1 total: abstenções ÷ aptos.
	measure 'Taxa de abstenção (zona) · K1' = DIVIDE([Abstenções (zona) · K6], [Aptos (zona)])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 65c82ec6-0bbd-582b-b22c-2d2341dc5cd8

	/// Nominais + legenda.
	measure 'Votos válidos (zona)' =
			VAR _cargo = IF(HASONEVALUE(DIM_CARGO[cd_cargo]), VALUES(DIM_CARGO[cd_cargo]), 1)
			VAR _turno = IF(HASONEVALUE(DIM_ELEICAO[nr_turno]), VALUES(DIM_ELEICAO[nr_turno]), 1)
			RETURN
			    CALCULATE(SUM(FATO_DETALHE_ZONA[qt_votos_nominais]) + SUM(FATO_DETALHE_ZONA[qt_votos_legenda]), DIM_CARGO[cd_cargo] = _cargo, DIM_ELEICAO[nr_turno] = _turno)
		formatString: #,0
		lineageTag: 36e483e6-f78a-50d4-8dc3-5891baf5aace

	measure 'Brancos e nulos (zona) · K2' =
			VAR _cargo = IF(HASONEVALUE(DIM_CARGO[cd_cargo]), VALUES(DIM_CARGO[cd_cargo]), 1)
			VAR _turno = IF(HASONEVALUE(DIM_ELEICAO[nr_turno]), VALUES(DIM_ELEICAO[nr_turno]), 1)
			RETURN
			    CALCULATE(SUM(FATO_DETALHE_ZONA[qt_votos_brancos]) + SUM(FATO_DETALHE_ZONA[qt_votos_nulos]), DIM_CARGO[cd_cargo] = _cargo, DIM_ELEICAO[nr_turno] = _turno)
		formatString: #,0
		lineageTag: ddf95916-deec-5662-87fa-dbd9bd9252f1

	measure 'Taxa de brancos e nulos (zona) · K2b' = DIVIDE([Brancos e nulos (zona) · K2], [Comparecimento (zona)])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 15514220-6040-59d1-ad1a-0e673dc98c13

	/// K8: votos válidos ÷ aptos.
	measure 'Engajamento global · K8' = DIVIDE([Votos válidos (zona)], [Aptos (zona)])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 620f1735-1bc1-5a2d-aee2-a73c4c6898e3

	/// K9: votos válidos ÷ abstenções.
	measure 'Válidos por abstenção · K9' = DIVIDE([Votos válidos (zona)], [Abstenções (zona) · K6])
		formatString: 0.00
		lineageTag: 87b38def-9d4c-5225-a2ee-3062eadd04f7

	/// Ranking por aptos entre zonas com abstenção acima de 20%.
	measure 'Posição Q5' =
			VAR _taxa = [Taxa de abstenção (zona) · K1]
			RETURN
			    IF(_taxa > 0.20,
			        RANKX(FILTER(ALLSELECTED(DIM_ZONA[Zona (capital)]), [Taxa de abstenção (zona) · K1] > 0.20),
			              [Aptos (zona)], , DESC))
		formatString: 0
		lineageTag: 92e16ac7-60b0-59db-9a7c-6f1c6620ce39

	measure 'Aptos · Top 20 (Q5)' = VAR _p = [Posição Q5] RETURN IF(NOT ISBLANK(_p) && _p <= 20, [Aptos (zona)])
		formatString: #,0
		lineageTag: 6639ff6c-a54f-52f4-94c2-2200d7b671dc

	measure 'Taxa de abstenção · Top 20 (Q5)' = VAR _p = [Posição Q5] RETURN IF(NOT ISBLANK(_p) && _p <= 20, [Taxa de abstenção (zona) · K1])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 44f27e4e-d9ac-59df-8465-ff2f1bca9b22

	measure 'Abstenções · Top 20 (Q5)' = VAR _p = [Posição Q5] RETURN IF(NOT ISBLANK(_p) && _p <= 20, [Abstenções (zona) · K6])
		formatString: #,0
		lineageTag: 2eb13c7c-48df-5e1b-8bd6-f7ef472160e8

