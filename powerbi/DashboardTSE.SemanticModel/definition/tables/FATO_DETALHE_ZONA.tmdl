	partition FATO_DETALHE_ZONA = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(Servidor, Banco),
				    Tabela = Fonte{[Schema="dw", Item="FATO_DETALHE_ZONA"]}[Data],
				    Colunas = Table.SelectColumns(Tabela, {"sk_eleicao", "sk_cargo", "sk_municipio", "sk_zona", "qt_aptos", "qt_comparecimento", "qt_abstencoes", "qt_votos_nominais", "qt_votos_legenda", "qt_votos_brancos", "qt_votos_nulos"})
				in
