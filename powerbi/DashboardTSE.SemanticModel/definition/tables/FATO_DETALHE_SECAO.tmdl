				    Tabela = Fonte{[Schema="dw", Item="FATO_DETALHE_SECAO"]}[Data],
				    Colunas = Table.SelectColumns(Tabela, {"sk_eleicao", "sk_cargo", "sk_municipio", "sk_zona", "sk_secao", "qt_aptos", "qt_comparecimento", "qt_abstencoes", "qt_votos_nominais", "qt_votos_legenda", "qt_votos_brancos", "qt_votos_nulos", "fl_secao_instalada"})
