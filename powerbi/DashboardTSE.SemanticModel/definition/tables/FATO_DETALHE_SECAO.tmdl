table FATO_DETALHE_SECAO
	lineageTag: 645aeed1-3c46-5ec2-b57b-9a1d298d6cd0

	/// Base 8, sem seções não instaladas ou com zero aptos (regra 6.1).
	measure 'Aptos (seção)' =
			VAR _cargo = IF(HASONEVALUE(DIM_CARGO[cd_cargo]), VALUES(DIM_CARGO[cd_cargo]), 1)
			VAR _turno = IF(HASONEVALUE(DIM_ELEICAO[nr_turno]), VALUES(DIM_ELEICAO[nr_turno]), 1)
			RETURN
			    CALCULATE(SUM(FATO_DETALHE_SECAO[qt_aptos]), FATO_DETALHE_SECAO[considerar] = 1, DIM_CARGO[cd_cargo] = _cargo, DIM_ELEICAO[nr_turno] = _turno)
		formatString: #,0
		lineageTag: 0da3acca-f8fc-596c-ba05-bf11b9149a51

	measure 'Comparecimento (seção)' =
			VAR _cargo = IF(HASONEVALUE(DIM_CARGO[cd_cargo]), VALUES(DIM_CARGO[cd_cargo]), 1)
			VAR _turno = IF(HASONEVALUE(DIM_ELEICAO[nr_turno]), VALUES(DIM_ELEICAO[nr_turno]), 1)
			RETURN
			    CALCULATE(SUM(FATO_DETALHE_SECAO[qt_comparecimento]), FATO_DETALHE_SECAO[considerar] = 1, DIM_CARGO[cd_cargo] = _cargo, DIM_ELEICAO[nr_turno] = _turno)
		formatString: #,0
		lineageTag: 849dbe63-a8f5-5f15-8852-4f1d50d69631

	measure 'Abstenções (seção)' =
			VAR _cargo = IF(HASONEVALUE(DIM_CARGO[cd_cargo]), VALUES(DIM_CARGO[cd_cargo]), 1)
			VAR _turno = IF(HASONEVALUE(DIM_ELEICAO[nr_turno]), VALUES(DIM_ELEICAO[nr_turno]), 1)
			RETURN
			    CALCULATE(SUM(FATO_DETALHE_SECAO[qt_abstencoes]), FATO_DETALHE_SECAO[considerar] = 1, DIM_CARGO[cd_cargo] = _cargo, DIM_ELEICAO[nr_turno] = _turno)
		formatString: #,0
		lineageTag: 7452ac49-7b0d-557c-87df-960a4e1f7714

	measure 'Seções consideradas' =
			VAR _cargo = IF(HASONEVALUE(DIM_CARGO[cd_cargo]), VALUES(DIM_CARGO[cd_cargo]), 1)
			VAR _turno = IF(HASONEVALUE(DIM_ELEICAO[nr_turno]), VALUES(DIM_ELEICAO[nr_turno]), 1)
			RETURN
			    CALCULATE(COUNTROWS(FATO_DETALHE_SECAO), FATO_DETALHE_SECAO[considerar] = 1, DIM_CARGO[cd_cargo] = _cargo, DIM_ELEICAO[nr_turno] = _turno)
		formatString: #,0
		lineageTag: e5926b5d-357f-52dd-a117-7a43df9114de

	measure 'Taxa de abstenção (seção) · K1' = DIVIDE([Abstenções (seção)], [Aptos (seção)])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 50da5e49-a2e2-503d-8f2b-fa19bf84a160

	measure 'Aptos médios por seção' = DIVIDE([Aptos (seção)], [Seções consideradas])
		formatString: #,0
		lineageTag: f5b1c64c-9676-5953-ae2a-1ffa4b14b9be

	measure 'Brancos e nulos (seção) · K2' =
			VAR _cargo = IF(HASONEVALUE(DIM_CARGO[cd_cargo]), VALUES(DIM_CARGO[cd_cargo]), 1)
			VAR _turno = IF(HASONEVALUE(DIM_ELEICAO[nr_turno]), VALUES(DIM_ELEICAO[nr_turno]), 1)
			RETURN
			    CALCULATE(SUM(FATO_DETALHE_SECAO[qt_votos_brancos]) + SUM(FATO_DETALHE_SECAO[qt_votos_nulos]), FATO_DETALHE_SECAO[considerar] = 1, DIM_CARGO[cd_cargo] = _cargo, DIM_ELEICAO[nr_turno] = _turno)
		formatString: #,0
		lineageTag: f4e91b4a-c2b6-50fb-a0f4-26daae9192b9

	/// K2b: (brancos + nulos) ÷ comparecimento.
	measure 'Taxa de brancos e nulos (seção) · K2b' = DIVIDE([Brancos e nulos (seção) · K2], [Comparecimento (seção)])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d0a81267-809b-5961-9d3b-543b08dea0a8

	/// Atributo da seção: vazio em totais.
	measure '% sem médio da seção · K11a' = IF(HASONEVALUE(DIM_SECAO[sk_secao]), MAX(DIM_SECAO[% sem médio completo · K11a]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b8791858-ed7c-564a-861f-de3fdb8ddfec

	measure 'K11a · baixa escolaridade (Q2)' = CALCULATE([% sem médio da seção · K11a], DIM_SECAO[Baixa escolaridade] = "Sim")
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: aaf25658-7039-5c19-840e-d4102b521027

	measure 'K2 · baixa escolaridade (Q2)' = CALCULATE([Brancos e nulos (seção) · K2], DIM_SECAO[Baixa escolaridade] = "Sim")
		formatString: #,0
		lineageTag: 9f5542f1-8321-535c-ae55-a426c438c3f6

	measure 'K2b · baixa escolaridade (Q2)' = CALCULATE([Taxa de brancos e nulos (seção) · K2b], DIM_SECAO[Baixa escolaridade] = "Sim")
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: dbedb9fc-b515-57a1-bb33-94db157aee45

	measure 'K2b · alta escolaridade (Q6)' = CALCULATE([Taxa de brancos e nulos (seção) · K2b], DIM_SECAO[Alta escolaridade] = "Sim")
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 6f467c5a-f6dd-5af3-8959-ee5c03a8e6f4

	column considerar = IF(FATO_DETALHE_SECAO[qt_aptos] > 0 && COALESCE(FATO_DETALHE_SECAO[fl_secao_instalada], TRUE()), 1, 0)
		dataType: int64
		isHidden
		lineageTag: 1ef5f697-ff74-5294-9b50-7cdf20d53539
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

